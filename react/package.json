{
  "name": "template",
  "version": "1.0.0",
  "private": true,
  "homepage": ".",
  "type": "module",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "jotai": "^2.20.3",
    "moment-timezone": "^0.6.3",
    "odata-query": "^8.1.0",
    "react": "^19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "web-vitals": "^6.2.1"
  },
  "scripts": {
    "start": "rsbuild dev",
    "clean": "rm -Rf node_modules && rm *.app && rm -Rf build",
    "build": "npm run build:build && npm run build:fix-css && npm run build:rename && npm run build:zip && npm run build:unrename",
    "build:build": "NODE_ENV=production rsbuild build",
	"build:fix-css": "sed -i '' 's|url(./static|url(../../static|g' build/static/css/*.css",
    "build:rmmap": "rm ./build/static/js/*.map",
    "build:rename": "mv build template && touch template.app",
    "build:zip": "rm template.app && zip -r9v template.app template",
    "build:unrename": "mv template build",
	"preview": "rsbuild preview",
	"test": "rsbuild test"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@rsbuild/core": "^2.2.3",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
	"react-refresh": "^0.18.0",
    "sass": "^1.104.0",
    "typescript": "^7.0.2"
  },
  "proxy": "http://localhost:9000/rest"
}
